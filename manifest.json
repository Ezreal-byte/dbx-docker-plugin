{
  "manifest_version": 1,
  "id": "io.dbx.docker",
  "name": "Docker",
  "version": "0.1.1",
  "publisher": "ezreal-byte",
  "description": "Docker Engine workbench: containers, images, volumes, networks, logs, files, monitoring and Compose apply.",
  "icon": "assets/plugin.svg",
  "permissions": ["host.workbench", "host.binary"],
  "engines": { "dbx": ">=0.6.14", "host_api": "1" },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-docker-plugin",
      "transport": "stdio-framed",
      "protocol_versions": [1]
    },
    "ui": { "root": "ui", "entry": "ui/index.html" }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.docker.connection",
      "label": "Docker",
      "icon": "assets/plugin.svg",
      "database_type": "docker",
      "fields": [
        { "key": "display_name", "label": "连接名称", "type": "text", "default": "Docker", "binding": "name" },
        {
          "key": "protocol", "label": "协议", "type": "select", "binding": "config", "default": "http",
          "options": [
            { "label": "HTTP (TCP)", "value": "http" },
            { "label": "HTTPS (TCP + TLS)", "value": "https" },
            { "label": "Unix Socket (本机)", "value": "unix" },
            { "label": "Unix Socket over SSH (nc)", "value": "unix-over-nc" },
            { "label": "Unix Socket over SSH (sudo nc)", "value": "unix-over-nc-sudo" }
          ]
        },
        { "key": "host", "label": "主机", "type": "text", "binding": "host", "placeholder": "127.0.0.1（HTTP/HTTPS 必填）" },
        { "key": "port", "label": "端口", "type": "number", "binding": "port", "placeholder": "2375 / 2376" },
        { "key": "socket_path", "label": "Socket 路径", "type": "text", "binding": "config", "default": "/var/run/docker.sock" },
        { "key": "api_version", "label": "API 版本", "type": "text", "binding": "config", "default": "auto", "placeholder": "auto 或 1.44" },
        { "key": "allow_insecure_remote_http", "label": "允许不安全的远程 HTTP", "type": "boolean", "binding": "config", "default": false },
        { "key": "ca_cert_path", "label": "CA 证书路径 (HTTPS)", "type": "text", "binding": "config", "placeholder": "C:/certs/ca.pem" },
        { "key": "client_cert_path", "label": "客户端证书路径 (HTTPS)", "type": "text", "binding": "config", "placeholder": "C:/certs/cert.pem" },
        { "key": "client_key_path", "label": "客户端私钥路径 (HTTPS)", "type": "text", "binding": "config", "placeholder": "C:/certs/key.pem" },
        { "key": "ssh_host", "label": "SSH 主机 (nc 模式)", "type": "text", "binding": "config", "placeholder": "server.example.com" },
        { "key": "ssh_port", "label": "SSH 端口", "type": "number", "binding": "config", "default": 22 },
        { "key": "ssh_username", "label": "SSH 用户名", "type": "text", "binding": "config" },
        { "key": "ssh_password", "label": "SSH 密码", "type": "password", "binding": "secret" },
        { "key": "ssh_private_key_path", "label": "SSH 私钥路径", "type": "text", "binding": "config", "placeholder": "C:/Users/you/.ssh/id_rsa" },
        { "key": "ssh_known_hosts_path", "label": "SSH known_hosts 路径", "type": "text", "binding": "config", "placeholder": "默认 ~/.ssh/known_hosts" },
        { "key": "read_only", "label": "只读模式", "type": "boolean", "binding": "config", "default": false },
        { "key": "is_production", "label": "生产环境", "type": "boolean", "binding": "config", "default": false }
      ],
      "workbench": "io.dbx.docker.workbench",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "io.dbx.docker.workbench",
      "label": "Docker 工作台",
      "icon": "assets/plugin.svg"
    }
  ]
}
