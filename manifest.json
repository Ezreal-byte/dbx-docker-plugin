{
  "manifest_version": 1,
  "id": "io.dbx.docker",
  "name": "Docker",
  "version": "0.3.0",
  "publisher": "ezreal-byte",
  "description": "Manage Docker containers, images, volumes, networks and Compose, with built-in DBX AI and MCP tools for queries and permission-controlled operations.",
  "icon": "assets/plugin.svg",
  "permissions": [
    "host.workbench",
    "host.binary",
    "host.ai"
  ],
  "engines": {
    "dbx": ">=0.6.43",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-docker-plugin",
      "transport": "stdio-framed",
      "protocol_versions": [
        1
      ]
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.docker.connection",
      "label": "Docker",
      "icon": "assets/plugin.svg",
      "database_type": "docker",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "Docker",
          "binding": "name"
        },
        {
          "key": "protocol",
          "label": "Connection method",
          "description": "Local (OS default) uses the Windows named pipe or /var/run/docker.sock on macOS/Linux. Select an explicit socket mode for a custom path.",
          "type": "select",
          "binding": "config",
          "default": "http",
          "required": true,
          "options": [
            {
              "label": "Local (OS default socket)",
              "value": "local"
            },
            {
              "label": "HTTP (TCP)",
              "value": "http"
            },
            {
              "label": "HTTPS (TCP + TLS)",
              "value": "https"
            },
            {
              "label": "Unix socket (local)",
              "value": "unix"
            },
            {
              "label": "Windows Named Pipe (local)",
              "value": "npipe"
            },
            {
              "label": "SSH (Unix socket)",
              "value": "unix-over-nc"
            },
            {
              "label": "SSH (Unix socket, sudo)",
              "value": "unix-over-nc-sudo"
            }
          ]
        },
        {
          "key": "host",
          "label": "Docker host",
          "type": "text",
          "binding": "host",
          "default": "127.0.0.1",
          "description": "For an SSH tunnel, enter the Docker address reachable from the remote host, then configure Tunnel / Proxy.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "http",
              "https"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "http",
              "https"
            ]
          }
        },
        {
          "key": "port",
          "label": "Docker port",
          "type": "number",
          "binding": "port",
          "default": 2375,
          "description": "HTTP usually uses 2375; set 2376 for HTTPS.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "http",
              "https"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "http",
              "https"
            ]
          }
        },
        {
          "key": "allow_insecure_remote_http",
          "label": "Allow insecure remote HTTP",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "Not needed for localhost or a DBX SSH tunnel.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "http"
            ]
          }
        },
        {
          "key": "ca_cert_path",
          "label": "CA certificate",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file",
            "accept": [
              ".pem",
              ".crt"
            ]
          },
          "description": "Optional; leave empty to use the system trust store.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "https"
            ]
          }
        },
        {
          "key": "client_cert_path",
          "label": "Client certificate",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file",
            "accept": [
              ".pem",
              ".crt"
            ]
          },
          "description": "For mutual TLS; provide both the certificate and private key.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "https"
            ]
          }
        },
        {
          "key": "client_key_path",
          "label": "Client private key",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file",
            "accept": [
              ".pem",
              ".key"
            ]
          },
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "https"
            ]
          }
        },
        {
          "key": "ssh_host",
          "label": "SSH host",
          "type": "text",
          "binding": "config",
          "placeholder": "server.example.com",
          "description": "Connects directly over SSH. Leave Tunnel / Proxy empty for this method.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "ssh_port",
          "label": "SSH port",
          "type": "number",
          "binding": "config",
          "default": 22,
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "ssh_username",
          "label": "SSH username",
          "type": "text",
          "binding": "config",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "ssh_private_key_path",
          "label": "SSH private key",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file"
          },
          "description": "Optional when using password authentication.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "ssh_password",
          "label": "SSH password / key passphrase",
          "type": "password",
          "binding": "secret",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "ssh_known_hosts_path",
          "label": "Trusted host keys",
          "type": "text",
          "binding": "config",
          "picker": {
            "kind": "file"
          },
          "placeholder": "Defaults to ~/.ssh/known_hosts",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "socket_path",
          "label": "Socket path",
          "type": "text",
          "binding": "config",
          "default": "/var/run/docker.sock",
          "description": "With SSH, this is the path on the remote host; otherwise it is a local Unix socket.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "unix",
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "unix",
              "unix-over-nc",
              "unix-over-nc-sudo"
            ]
          }
        },
        {
          "key": "pipe_path",
          "label": "Named Pipe path",
          "type": "text",
          "binding": "config",
          "default": "//./pipe/docker_engine",
          "description": "Windows only. Accepts //./pipe/<name> or \\\\.\\pipe\\<name>; no TCP port is required.",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "npipe"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "npipe"
            ]
          }
        },
        {
          "key": "api_version",
          "label": "API version",
          "type": "text",
          "binding": "config",
          "default": "auto",
          "placeholder": "auto or 1.44"
        },
        {
          "key": "read_only",
          "label": "Read-only mode",
          "type": "boolean",
          "binding": "config",
          "default": false
        },
        {
          "key": "is_production",
          "label": "Production environment",
          "type": "boolean",
          "binding": "config",
          "default": false
        }
      ],
      "workbench": "io.dbx.docker.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.docker.workbench",
      "label": "Docker workbench",
      "icon": "assets/plugin.svg",
      "ai": {
        "recommendations": [
          {
            "id": "docker-health",
            "label": "Docker health overview",
            "prompt": "Inspect containers, networks and volume references for the current Docker connection. Use query tools only.",
            "order": 10
          }
        ]
      }
    },
    {
      "type": "mcp",
      "id": "io.dbx.docker.mcp",
      "ai_tools": true,
      "external_tools": true
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "Docker",
      "description": "Docker 管理工作台：容器、镜像、卷、网络、日志、文件、监控与 Compose；支持 DBX 内置 AI 和 MCP 查询及按连接授权的管理操作。",
      "contributions": {
        "io.dbx.docker.connection": {
          "label": "Docker",
          "fields": {
            "display_name": {
              "label": "连接名称"
            },
            "protocol": {
              "label": "连接方式",
              "description": "本机（系统默认）使用 Windows 命名管道或 macOS/Linux 的 /var/run/docker.sock；自定义路径请选择对应的 Socket / 命名管道方式。",
              "options": {
                "local": "本机（系统默认）",
                "http": "HTTP (TCP)",
                "https": "HTTPS (TCP + TLS)",
                "unix": "Unix Socket（本机）",
                "unix-over-nc": "SSH（Unix Socket）",
                "unix-over-nc-sudo": "SSH（Unix Socket，sudo）",
                "npipe": "Windows 命名管道（本机）"
              }
            },
            "host": {
              "label": "Docker 主机",
              "description": "使用 SSH 隧道时，填写远端可访问的 Docker 地址，再配置“隧道/代理”页。"
            },
            "port": {
              "label": "Docker 端口",
              "description": "HTTP 通常为 2375；HTTPS 请改为 2376。"
            },
            "socket_path": {
              "label": "Socket 路径",
              "description": "SSH 方式填写远端路径；本机方式填写本地 Unix Socket 路径。"
            },
            "api_version": {
              "label": "API 版本",
              "placeholder": "auto 或 1.44"
            },
            "allow_insecure_remote_http": {
              "label": "允许不安全的远程 HTTP",
              "description": "连接本机或使用 DBX SSH 隧道时，无需开启。"
            },
            "ca_cert_path": {
              "label": "CA 证书",
              "description": "可选；留空时使用系统信任的证书。"
            },
            "client_cert_path": {
              "label": "客户端证书",
              "description": "双向 TLS 使用；证书和私钥需同时填写。"
            },
            "client_key_path": {
              "label": "客户端私钥"
            },
            "ssh_host": {
              "label": "SSH 主机",
              "description": "由插件直接连接 SSH，此方式请将“隧道/代理”页留空。"
            },
            "ssh_port": {
              "label": "SSH 端口"
            },
            "ssh_username": {
              "label": "SSH 用户名"
            },
            "ssh_password": {
              "label": "SSH 密码 / 私钥口令"
            },
            "ssh_private_key_path": {
              "label": "SSH 私钥",
              "description": "密码登录时可留空。"
            },
            "ssh_known_hosts_path": {
              "label": "可信主机密钥文件",
              "placeholder": "默认 ~/.ssh/known_hosts"
            },
            "read_only": {
              "label": "只读模式"
            },
            "is_production": {
              "label": "生产环境"
            },
            "pipe_path": {
              "label": "命名管道路径",
              "description": "仅 Windows：支持 //./pipe/<name> 或 \\\\.\\pipe\\<name> 写法，无需开放 TCP 端口。"
            }
          }
        },
        "io.dbx.docker.workbench": {
          "label": "Docker 工作台"
        }
      }
    }
  }
}
